# Add this site block to the operator's Caddyfile.local using the REAL IPFS host.
# No direct Kubo route may bypass this gate. Bypass CDN caching for the hostname;
# cached blocks must be authorized again after a visibility/moderation change.
ipfs.example.com {
	@gateway {
		method GET HEAD
		path /ipfs/*
	}
	header Cache-Control "no-store"
	handle @gateway {
		forward_auth api:8080 {
			uri /api/v1/ipfs/gateway/authorize
			# Overwrite client-supplied values with the original request facts.
			header_up X-Forwarded-Uri {uri}
			header_up X-Forwarded-Method {method}
		}
		reverse_proxy ipfs:8080 {
			header_down Cache-Control "no-store"
		}
	}
	handle {
		respond 404
	}
}
