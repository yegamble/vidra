[Unit]
Description=Private socket for approved Vidra IPFS watch playback

[Socket]
ListenStream=/run/vidra-reference-playback/playback.sock
DirectoryMode=0755
# The container UID may have no host passwd entry. Start root-only and hand
# ownership to its numeric UID after binding the root-controlled path.
SocketMode=0600
ExecStartPost=/usr/bin/chown +10001 /run/vidra-reference-playback/playback.sock
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
