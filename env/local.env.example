# Local development (docker compose --env-file env/local.env ...)
# Copy to env/local.env and adjust. Canonical matrix: .ralph/specs/environments.md
VIDRA_ENV=development
HTTP_PORT=8080
FRONTEND_PORT=3000
PUBLIC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Disabled for normal local iteration. Set true when manually exercising limits.
RATE_LIMIT_ENABLED=false
# Both stay false even here. Turning either on is safe ONLY while the host is
# unreachable from the internet: DEV_MAIL_CAPTURE_ENABLED registers an unauthed
# endpoint that hands out live password-reset tokens for any address, and
# HTTP_IMPORT_ALLOW_PRIVATE_URLS disables the SSRF guard (importer can then reach
# 169.254.169.254 and RFC1918). vidra-core only refuses them when
# VIDRA_ENV=production, and this file sets development — nothing else stops you.
DEV_MAIL_CAPTURE_ENABLED=false
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false
MAIL_ENABLED=false
TRANSCODING_ENABLED=true
# Malware scanning is derived from CLAMAV_ADDR, and an instance with neither a
# scanner nor an explicit opt-out refuses every upload with 503
# scanner_not_configured.
#
# THIS IS A DEV TEMPLATE AND IT TAKES THE OPT-OUT ON PURPOSE. The production and
# staging templates ship scanning ON; this one cannot, because the Makefile's dev
# targets hardcode `--profile core --profile frontend` and never start the
# bundled clamd. Pointing CLAMAV_ADDR at a container that no dev target runs
# would make fail-closed refuse every upload on `make dev` — the opt-out is
# exactly the mechanism for "this instance ingests unscanned, and says so".
#
# It costs a boot WARN and one system.malware_scan.disabled audit row per boot,
# which is the point: even here, the absence of scanning is on the record.
#
# To develop AGAINST a real scanner, add `--profile scan` to your compose
# command, set CLAMAV_ADDR=clamav:3310, and delete this line (a configured
# scanner alongside `disabled` is refused at boot).
MALWARE_SCAN_MODE=disabled
STORAGE_BACKEND=local
FEDERATION_ENABLED=false
REGISTRATION_REQUIRE_APPROVAL=false
# IPFS is opt-in. `make ipfs-live` overrides these for a real public provider plus
# the separate swarm.key'd private mirror. Leave public-network mode false during
# ordinary local development: publishing a CID is not reversible.
IPFS_ENABLED=false
IPFS_PUBLIC_NETWORK=false
IPFS_GATEWAY_URL=http://localhost:9090
IPFS_MIRROR_PRIVATE=false
# vidra-search (internal autosuggest/search/recommendations service; core-only,
# never browser-facing). SEARCH_HTTP_PORT is the host port for its :8080.
# SEARCH_INTERNAL_SECRET is the shared HMAC secret core and search authenticate
# with — it flows to BOTH api's SEARCH_INTERNAL_SECRET and search's INTERNAL_SECRET,
# so they always match.
#   generate: openssl rand -hex 32
SEARCH_HTTP_PORT=8081
SEARCH_INTERNAL_SECRET=<generate: openssl rand -hex 32>
