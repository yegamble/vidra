# ==============================================================================
# VIDRA — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to env/production.env and fill in. That file is gitignored; this one is
# committed, so it must never contain a real secret.
#
#   cp env/production.env.example env/production.env
#   $EDITOR env/production.env
#   git check-ignore -v env/production.env      # MUST match, or stop
#
# HOW THIS FILE REACHES THE CONTAINERS
# ------------------------------------
# It is passed with `--env-file`, which feeds compose VARIABLE SUBSTITUTION only.
# A key reaches a container solely because that service's `environment:` map in
# docker-compose.yml (or vidra-core/docker-compose.yml) names it — there is no
# env_file: anywhere in the stack and no wildcard passthrough. Adding a key here
# that has no ${...} consumer in a compose file does NOTHING. If you need one,
# add it to the api service's environment map first.
#
# `--env-file` DOES propagate into the `include:`d vidra-core compose file, and it
# WINS for every key it defines. It does NOT, however, replace vidra-core/.env
# wholesale: any key this file leaves unset still falls through to that file if it
# exists. A host that only ever ran ./bootstrap.sh has no vidra-core/.env (it is
# gitignored and never cloned), which is the expected state — but if you are
# deploying from a directory that was also used for development, DELETE
# vidra-core/.env first. A stale developer DATABASE_URL pointing at localhost is
# the failure mode: it would land inside the api container, where localhost is the
# container itself.
#   verify: docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#             --env-file env/production.env --profile core --profile frontend config
#
# Promotion rule: deploy the EXACT image tags staging validated.
# Canonical matrix: .ralph/specs/environments.md
#
# BEFORE FIRST BOOT, replace every <generate: ...> placeholder below. They are
# deliberately malformed so the api refuses to start rather than booting with a
# value that is published in this repository.
# ==============================================================================

VIDRA_ENV=production

# ------------------------------------------------------------------------------
# Release tags — which images to pull
# ------------------------------------------------------------------------------
# Consumed by docker-compose.prod.yml (image: ghcr.io/.../vidra-core:${VIDRA_CORE_TAG}).
# They are REQUIRED there: rendering fails if they are unset, which is deliberate —
# an untagged production deploy has nothing to roll back to. Roll back by rewriting
# these to the previous tag and re-running the deploy.
#
# TWO DIFFERENT NUMBERS LIVE HERE, and confusing them is how this file went
# three releases stale.
#
# THE FLOOR is deploy/deploy.sh's MIN_EMBEDDED_MIGRATE_TAG. The two migrator
# tags may not go below it: older vidra-core / vidra-search images have no
# embedded `migrate` subcommand, so the migration one-shots would boot API
# servers that never exit — see "Upgrade notes" in deploy/README.md. It is a
# compatibility bound, it is deliberately old, and it never moves down.
#
# THE RECOMMENDATION is the three values below — the release a fresh install
# actually deploys. It must be bumped on EVERY release; deploy/release.sh prints
# that instruction as the last thing it does after cutting one.
#
# Leaving the recommendation sitting on the floor fails SILENTLY on the checkout
# path: deploy/deploy.sh pins ./vidra-core and ./vidra-search to VIDRA_*_TAG
# BEFORE it reads expected_version out of those checkouts' migrations, so the
# ledger assertion compares the stale release against itself, matches, and the
# deploy exits 0 having shipped release-old code. (On the bundle path the same
# staleness at least fails loudly, with a schema number and no mention of tags.)
# tests/install_test.sh asserts the two numbers stay distinct.
VIDRA_CORE_TAG=v0.6.0
VIDRA_USER_TAG=v0.6.0
VIDRA_SEARCH_TAG=v0.6.0

# OPTIONAL. The GHCR owner the three images are pulled from — the overlay
# expands ghcr.io/${VIDRA_IMAGE_OWNER:-yegamble}/vidra-core etc. Leave it unset
# for the upstream images; set it only when deploying images published from a
# fork (your GitHub username or org, lowercase — GHCR paths are lowercase).
# Forks also set GITHUB_OWNER (deploy/release.sh) and VIDRA_GH_OWNER
# (bootstrap.sh) to the same owner.
# VIDRA_IMAGE_OWNER=yegamble

# ------------------------------------------------------------------------------
# Origin topology — ONE domain, routed by path
# ------------------------------------------------------------------------------
# PUBLIC_BASE_URL is used for BOTH halves of the site: watch/embed/channel links
# in RSS, oEmbed and the sitemap, AND the API-side callback/identity URLs (OAuth
# redirect_uri, NodeInfo, ActivityPub + atproto actor ids). A split
# api.example.com / example.com deployment therefore cannot be correct with one
# value — pointing it at the API origin 404s every feed link, pointing it at the
# web origin breaks OAuth and federation.
#
# The fix is topological: serve everything from ONE origin and let the reverse
# proxy route /api/*, /healthz, /readyz, /version, /sitemap.xml, /feeds/*,
# /nodeinfo/* and /.well-known/* to the api and everything else to the frontend
# (see deploy/Caddyfile). Frontend /videos/{id} and api /api/v1/videos/{id} do
# not collide. CORS becomes same-origin as a bonus.
#
# Must be https in production and must NOT include a path or trailing slash.
PUBLIC_BASE_URL=https://example.com

# The origin the BROWSER calls for the API. Same value, same reason.
#
# READ AT RUNTIME, not baked in. The name still carries Next.js's NEXT_PUBLIC_
# prefix, which used to mean "inlined into the client bundle at image build time"
# — and this template used to warn at length that setting it here did nothing to
# a PULLED image. That is no longer true, and has not been since the frontend
# started serving its own /runtime-config.js: docker-compose.yml passes this
# value into the container as PUBLIC_API_BASE_URL, the frontend serves it to the
# browser at request time, and a restart applies a change with no rebuild. The
# build-time inline survives only as the dev/e2e fallback (vidra-user
# lib/config.ts resolves runtime config first).
#
# Under the single-origin topology above, this is simply PUBLIC_BASE_URL again.
NEXT_PUBLIC_API_BASE_URL=https://example.com

# Explicit, comma-separated allow-list. Wildcards are rejected in production.
# Same-origin under the single-domain topology, but a valid value is still required.
CORS_ALLOWED_ORIGINS=https://example.com

# Host ports the reverse proxy connects to. docker-compose.prod.yml publishes both
# on 127.0.0.1 ONLY — a host firewall does NOT filter Docker-published ports
# (Docker's DOCKER-USER iptables chain runs ahead of ufw), so the loopback bind is
# the actual control.
HTTP_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# TLS / ACME + component profiles — both written by `vidra setup`
# ------------------------------------------------------------------------------
# `vidra setup` renders deploy/Caddyfile.local from deploy/Caddyfile using the
# values below (the template is never mounted; docker-compose.prod.yml mounts
# ONLY deploy/Caddyfile.local, and deploy.sh refuses to start without it).
#
#   acme          Let's Encrypt production. The default, and what a real site
#                 wants. deploy.sh runs a DNS preflight first: the host of
#                 PUBLIC_BASE_URL must already resolve to THIS machine's public
#                 IP, because a failed order burns Let's Encrypt rate limit
#                 (5 failed authorisations per account/hostname/hour) and the
#                 site then serves nothing over TLS until it clears.
#   acme-staging  Let's Encrypt's staging CA — untrusted certificates, but
#                 effectively unlimited retries. Use it while DNS is settling.
#   internal      Caddy's own local CA (self-signed). No DNS preflight, no ACME
#                 at all: for a LAN/VPN-only instance or a smoke test. Browsers
#                 will warn.
#   external      SOMEBODY ELSE terminates TLS: an nginx/HAProxy in front of this
#                 box, a cloud load balancer, a CDN. Vidra's own Caddy does NOT
#                 run — the deploy scripts withhold the `edge` compose profile —
#                 so nothing here competes for :80 and :443, and the Caddyfile,
#                 the DNS preflight and the caddy reload are all skipped (out
#                 loud). PUBLIC_BASE_URL stays https: the site IS on TLS, it is
#                 just not this container's TLS. Your proxy must forward to the
#                 loopback ports below and set X-Forwarded-Proto/-For; see
#                 deploy/nginx-external.conf.example and TRUSTED_PROXY_CIDRS.
#   plain-http    DELIBERATE NO TLS. For a lab, a LAN, an air-gapped network or
#                 a machine reachable only over a VPN or an SSH tunnel. Caddy
#                 still runs — one managed front door, just an http:// one — and
#                 PUBLIC_BASE_URL must be http://. Every credential, cookie and
#                 upload on this deployment crosses the network in the clear, so
#                 it also needs VIDRA_ALLOW_PLAIN_HTTP=true below: the api
#                 refuses an http:// origin in production without that explicit
#                 consent, and refusing is the correct default. Do not use it on
#                 anything the internet can reach.
# --- TLS / ACME (managed by `vidra setup`) ---
VIDRA_TLS_MODE=acme

# Where Let's Encrypt sends expiry and revocation notices. Optional but strongly
# recommended: without it you get no warning before a renewal problem becomes an
# outage. Ignored by every mode that makes no ACME order (internal, external,
# plain-http).
VIDRA_ACME_EMAIL=

# THE CONSENT SWITCH FOR plain-http, and nothing else. The api validates its
# configuration with production rules whatever VIDRA_ENV says, and an http://
# PUBLIC_BASE_URL is a hard refusal under them — because in every case except a
# deliberate lab it means a misconfiguration that would ship session cookies and
# passwords in the clear. Setting this to true is how you say "yes, I know, that
# is the topology I want": it makes the http:// origin legal, and it turns off
# Secure cookies and HSTS, which cannot work over plain HTTP anyway.
#
# It changes nothing for the other four modes. Leave it alone unless
# VIDRA_TLS_MODE=plain-http, in which case `vidra setup` writes it for you.
# VIDRA_ALLOW_PLAIN_HTTP=false

# WHO IS ALLOWED TO SAY WHERE A REQUEST CAME FROM. Comma-separated CIDRs; empty
# by default, which is the right value for every deployment where Vidra's own
# Caddy is the edge.
#
# The api derives a client's IP for rate limiting, abuse blocking and the audit
# log. Behind a proxy every request arrives from the proxy, so the real address
# has to come out of X-Forwarded-For — and a header is only as trustworthy as the
# hop that set it. Vidra already trusts the private ranges (the compose network,
# RFC1918, loopback), so a proxy on this host or on the same private network
# needs nothing here. This exists for the case those ranges cannot cover: a
# terminator on a PUBLIC address — a cloud load balancer, a CDN edge, a proxy in
# another datacentre — whose forwarded headers would otherwise be ignored,
# leaving every visitor rate-limited as one IP.
#
# List ONLY addresses you control. Trusting a range you do not own lets anyone in
# it forge X-Forwarded-For and evade every per-IP limit the instance has.
#   TRUSTED_PROXY_CIDRS=203.0.113.7/32,198.51.100.0/24
#
# ASSIGNED BLANK, not commented out, and deliberately: `vidra setup` does not
# manage this key, so `vidra doctor`'s template-drift check compares the env
# file against this template directly. A commented-out line is not a definition,
# which would make every correct external deployment that fills this in report a
# standing "assigns 1 key(s) the template does not define" warning — a permanent
# ⚠ on a healthy host, which is exactly what that check exists NOT to do.
TRUSTED_PROXY_CIDRS=

# OPTIONAL. This host's public IP, used only by deploy.sh's DNS preflight to
# check that PUBLIC_BASE_URL's host points here. Set it when the box is behind
# NAT or has no outbound access to an IP-echo service; leave unset and deploy.sh
# discovers it. VIDRA_SKIP_DNS_PREFLIGHT=1 skips the whole check (loudly).
# The preflight only runs for the two ACME modes, so this is ignored by the
# other three.
# VIDRA_PUBLIC_IP=

# --- Component profiles (managed by `vidra setup`) ---
# Space-separated docker compose profiles the deploy scripts enable.
VIDRA_COMPOSE_PROFILES=core frontend
# Set to true when using an external/managed service; deploy scripts then add
# the matching docker-compose.external-*.yml overlay so the bundled one never starts.
VIDRA_EXTERNAL_POSTGRES=false
VIDRA_EXTERNAL_REDIS=false

# Additional profiles, appended to VIDRA_COMPOSE_PROFILES (duplicates are
# collapsed). Kept as a separate key because the two have different owners:
# VIDRA_COMPOSE_PROFILES is rewritten by `vidra setup`, this one is yours.
#   EXTRA_COMPOSE_PROFILES=ipfs
# EXTRA_COMPOSE_PROFILES=
#
# --- Splitting the api and the workers (optional) ---
# By default ONE vidra-core container serves HTTP and runs every background
# worker — including ffmpeg. That means a busy transcode queue competes with
# request handling for the same CPU and memory, and the only way to give the
# transcoder more headroom is to give the HTTP server more too.
#
# The `worker` profile runs the SAME image as a second service with
# VIDRA_ROLE=worker, so the two halves can be sized and scaled separately:
#
#   EXTRA_COMPOSE_PROFILES=worker
#   API_ROLE=api
#
# Both lines, in that order of importance. The profile alone just ADDS workers
# beside an api that still runs its own — valid, but not the split. API_ROLE=api
# is what moves ffmpeg out of the api container.
#
# ⚠ API_ROLE=api WITH NO WORKER RUNNING MEANS NOTHING TRANSCODES, IMPORTS,
# MIRRORS OR SWEEPS. There is no interlock: a process cannot tell whether some
# other container is draining the queues. Never set API_ROLE without the profile.
#
# Scale with `docker compose --profile worker up -d --scale worker=3` — every
# queue claims under a lease, so more workers is more throughput, not duplicate
# work. Rolling back is config-only: remove both lines and redeploy.
# API_ROLE=all
#
# Resource envelopes (docker-compose.prod.yml). The api defaults target the
# 8 vCPU / 16 GB launch droplet; Docker REFUSES a cpus value above the host's
# core count. With the split on, take capacity OFF the api and give it to the
# worker — the sum still has to fit the box alongside Postgres. Budget ~4x
# UPLOAD_MAX_SIZE of scratch per concurrent transcode on the worker's volume.
#   API_CPUS=2.0
#   API_MEM_LIMIT=2g
#   WORKER_CPUS=4.0
#   WORKER_MEM_LIMIT=5g
# WORKER_CPUS=2.0
# WORKER_MEM_LIMIT=2g
#
# --- Connection pool + load-balancer knobs (optional; defaults match old behavior) ---
# Every vidra-core process (api AND each worker replica) opens its own pgx pool.
# Total demand against Postgres is DB_MAX_CONNS x processes — budget it against
# the server's max_connections (stock Postgres: 100; `vidra doctor` prints the
# arithmetic). Minimum accepted is 2: the cron-leader election pins one dedicated
# connection, so a 1-connection pool would starve the leader.
#   DB_MAX_CONNS=10
#   DB_MIN_CONNS=1
#   DB_CONN_MAX_LIFETIME=1h
#   DB_CONN_MAX_IDLE_TIME=30m
#
# Behind a load balancer, give the LB time to notice a draining replica before
# the listener closes: on SIGTERM the api flips /readyz to 503 ("draining"),
# waits this long, then shuts down. Set to at least 2x the LB's health-check
# interval. Default 0 keeps single-node deploys exactly as before. Behind any
# proxy/LB on a public address, also set TRUSTED_PROXY_CIDRS (above) so per-IP
# rate limits and view counting key on the real client, not the balancer — the
# full story is vidra-core docs/operations.md, "Behind a load balancer".
#   HTTP_DRAIN_DELAY=0
#
# EXTERNAL POSTGRES / REDIS — what else has to change:
#   * DATABASE_URL must name the managed database, and REDIS_URL +
#     SEARCH_REDIS_URL the managed cache (two DIFFERENT logical databases).
#     The overlays assert this at render time rather than letting a container
#     boot and dial a service that is no longer in the project.
#   * POSTGRES_PASSWORD / REDIS_PASSWORD must STILL be non-empty. Compose
#     interpolates docker-compose.prod.yml as it loads it — before profiles are
#     evaluated — so the bundled services' `${…:?}` assertions fire even though
#     those services never start. Set them to the managed instances' passwords.
#   * deploy/backup.sh and deploy/restore.sh refuse to run against an external
#     Postgres (they exec pg_dump/pg_restore inside the bundled container). Use
#     the provider's backups and point-in-time restore.

# ------------------------------------------------------------------------------
# Secrets — replace every placeholder; never commit the filled-in file
# ------------------------------------------------------------------------------
# JWT signing key for access tokens (HS256).
#   generate: openssl rand -base64 48
# Left EMPTY rather than pre-filled: an empty value falls back to the built-in dev
# constant, which the api REFUSES in production ("JWT_SECRET must be set in
# production"), as it also refuses anything under 32 bytes. That is a loud boot
# failure, which is what you want from a forgotten secret.
# Safe to rotate — it just logs everyone out.
JWT_SECRET=

# Base64 of exactly 32 bytes. Envelope-encrypts TOTP shared secrets at rest.
#   generate: openssl rand -base64 32
# IF THIS IS UNSET (and FEDERATION_KEY_KEK is too) EVERY TOTP SECRET IS STORED IN
# PLAINTEXT. There is no boot error for that case — only a warning in the api log
# — which is why this template ships a deliberately invalid placeholder rather
# than an empty value: a malformed KEK fails validation loudly.
# DESTRUCTIVE TO ROTATE: it seals rows already in the database, and no re-wrap
# job exists.
MFA_KEY_KEK=<generate: openssl rand -base64 32>

# Bundled PostgreSQL. Use HEX, not base64: this password is substituted into a
# postgres:// DSN, and base64's + and / characters would need percent-encoding.
#   generate: openssl rand -hex 32
# docker-compose.prod.yml references it as `${POSTGRES_PASSWORD:?...}`, so an
# env file that omits or blanks the key fails the render — the base file's dev
# default (`vidra`) can never silently become the production database password.
# Left EMPTY like JWT_SECRET/REDIS_PASSWORD above: `:?` fails on an empty value
# too, so an unedited copy is caught by `make prod-config` / deploy.sh's
# pre-flight. NOTE: on a host with an EXISTING database volume, set this to the
# database's CURRENT password — the value only initializes a fresh volume (see
# deploy/README.md).
POSTGRES_USER=vidra
POSTGRES_PASSWORD=
POSTGRES_DB=vidra

# Bundled Redis. docker-compose.prod.yml starts redis with
# --requirepass ${REDIS_PASSWORD} and derives both clients' DSNs from it
# (redis://:PASSWORD@redis:6379/0 for the api, /1 for search), so this ONE value
# is all that is needed — do not hand-write REDIS_URL as well, or the two drift
# and every command comes back NOAUTH. Same hex rationale as above.
#   generate: openssl rand -hex 32
# Left EMPTY for the same reason as JWT_SECRET above: docker-compose.prod.yml
# references it as `${REDIS_PASSWORD:?...}`, and that form fails the render on an
# EMPTY value as well as an unset one — so a copied-but-unedited env file is
# caught by `make prod-config` / deploy.sh's pre-flight instead of starting a
# Redis whose password is the literal string "<generate: openssl rand -hex 32>".
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Database DSN overrides (managed-service path)
# ------------------------------------------------------------------------------
# Unset, the api and the migrate job both build a DSN for the compose-network
# postgres from POSTGRES_USER/PASSWORD/DB above — that is the recommended launch
# configuration (bundled Postgres 18 on the droplet plus a nightly dump off-box).
#
# To move to a managed database later, set DATABASE_URL: this ONE value is the
# DSN for the api, the search service, and BOTH migration one-shots — search
# shares the same database in a separate `search` schema, so one pg_dump still
# covers both. (There used to be a second SEARCH_MIGRATE_DATABASE_URL here,
# needed only to append &x-migrations-table=vidra_search_migrations. The search
# migrator now compiles that ledger name in, so the variable is gone; a leftover
# line in an old env file is simply unused.)
# Managed Postgres rejects sslmode=disable — use require.
# DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-nyc3-00000-do-user-0-0.m.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@db-redis-nyc3-00000-do-user-0-0.m.db.ondigitalocean.com:25061/0
# The search service keeps its own Redis DB INDEX — never point it at /0.
# SEARCH_REDIS_URL=rediss://default:PASSWORD@db-redis-nyc3-00000-do-user-0-0.m.db.ondigitalocean.com:25061/1

# ------------------------------------------------------------------------------
# How long a migration may WAIT for a table lock before giving up
# ------------------------------------------------------------------------------
# Applied to BOTH migration one-shots by docker-compose.prod.yml, as
# PGOPTIONS="-c lock_timeout=${VIDRA_MIGRATE_LOCK_TIMEOUT}". Any Postgres
# interval literal ("5s", "30s", "2min"); "0" means wait forever.
#
# WHY IT EXISTS. Several core migrations build indexes, and none of them uses
# CREATE INDEX CONCURRENTLY — so each holds a SHARE lock on its table for the
# whole build. Postgres lock queues are FIFO: one long write transaction (a
# PeerTube import is the obvious one) is enough to make CREATE INDEX queue
# behind it, and then every subsequent write to that table queues behind the
# CREATE INDEX. Without a timeout that is a HANG, not a failure — deploy.sh
# stops at "3/6 migrations", after the pre-deploy dump and before the restart,
# with the old release still serving reads and silently refusing every signup
# and profile edit, and with nothing printed to say why. Bounding the wait makes
# it exit non-zero instead, which deploy.sh already reports and acts on.
#
# The bound is on the WAIT only. An index build that has ALREADY acquired its
# lock runs to completion however long it takes; statement_timeout is
# deliberately not set.
#
# WHEN TO RAISE IT. If a deploy fails with "canceling statement due to lock
# timeout", the answer is almost never a bigger number — it is to find the
# transaction holding the lock and let it finish or kill it:
#   SELECT pid, state, age(clock_timestamp(), xact_start), query
#     FROM pg_stat_activity WHERE state <> 'idle' ORDER BY xact_start;
# Then re-run the deploy. Note that the aborted attempt leaves schema_migrations
# dirty, exactly as any other mid-migration failure does — recover with
# "Migration failed mid-deploy" in deploy/README.md before retrying.
#
# ONE CAVEAT for the managed path: `options` travels in the connection startup
# packet, and a transaction-pooling PgBouncer in front of a managed instance may
# reject it. Point the migrator at the DIRECT (non-pooled) port — migrations
# should never run through a transaction pooler anyway.
VIDRA_MIGRATE_LOCK_TIMEOUT=5s

# ------------------------------------------------------------------------------
# Instance identity
# ------------------------------------------------------------------------------
# MUST be overridden: the built-in default is the literal "Vidra (dev)", and it is
# served publicly at GET /api/v1/instance, shown in NodeInfo, and used as the
# default TOTP issuer label in every user's authenticator app.
INSTANCE_NAME=Example Video

# Optional about/legal metadata, served publicly at GET /api/v1/instance. Emitted
# verbatim — supply full absolute URLs. The contact address also appears in NodeInfo.
INSTANCE_DESCRIPTION=
INSTANCE_TERMS_URL=
INSTANCE_PRIVACY_URL=
INSTANCE_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# Registration — read the "First boot" section of deploy/README.md BEFORE changing
# ------------------------------------------------------------------------------
# The FIRST account created on an empty users table is granted admin, on every
# signup path, and there is no CLI to create or promote an admin — recovery from a
# signup bot claiming ownership is raw SQL. So: ship false, bring the stack up,
# register the owner account yourself over the loopback port (or before DNS
# propagates), verify the admin surface, and only THEN set this true and re-deploy.
REGISTRATION_ENABLED=false
# Once registration is open, require an admin to approve each signup (the
# registration approval queue).
REGISTRATION_REQUIRE_APPROVAL=false

# ------------------------------------------------------------------------------
# Rate limits, timeouts and upload sizing
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Blanket per-IP budget for the /api/v1 surface, per RATE_LIMIT_WINDOW (1m).
RATE_LIMIT_REQUESTS=120
# Media GETs (thumbnails, HLS, storyboards, downloads, avatars) get their own much
# larger budget — one home page is a feed call plus ~20 thumbnails and HLS playback
# adds ~10 segments/minute, so they must not share the API bucket.
MEDIA_RATE_LIMIT_REQUESTS=3000
# The auth endpoints keep their strict 10-per-window default. Do NOT raise it.

# Per-request context deadline for ordinary API work.
HTTP_REQUEST_TIMEOUT=30s
# The separate, much longer deadline for the streaming routes (chunk PUTs, direct
# uploads, media GETs). Those are bounded by the client's link speed, not by
# server work: 1h covers a 2 GiB upload at ~4.7 Mbit/s.
HTTP_STREAM_REQUEST_TIMEOUT=1h

# Largest single original-file upload accepted.
# SIZING COUPLING: transcode scratch needs roughly 4x this per concurrent job
# (ffmpeg runs inside the api container). With 2G that is ~8 GB of scratch —
# budget the transcode_tmp volume accordingly or the disk fills.
UPLOAD_MAX_SIZE=2G

# Default per-user storage quota in BYTES. The code default is 0 = UNLIMITED,
# which is the wrong answer for any instance that accepts signups. 5 GiB below;
# admins can override per account (PATCH /api/v1/admin/users/{id}).
# CAVEAT: the quota sums video_files only — the HLS ladder in video_renditions is
# not counted, so real storage consumption exceeds this figure.
INSTANCE_DEFAULT_QUOTA_BYTES=5368709120

# ------------------------------------------------------------------------------
# Media storage — DigitalOcean Spaces (S3-compatible)
# ------------------------------------------------------------------------------
# Do NOT use STORAGE_BACKEND=local unless docker-compose.prod.yml mounts a volume
# at /app/data: the local root otherwise lives on the container's writable layer,
# so `up -d` destroys the media while the database rows survive pointing at nothing.
STORAGE_BACKEND=s3
# HOST ONLY — no scheme. A value containing "://" is rejected outright; the
# http/https choice is STORAGE_S3_USE_SSL. Use the regional endpoint, e.g.
# nyc3.digitaloceanspaces.com / fra1.digitaloceanspaces.com / sgp1....
STORAGE_S3_ENDPOINT=nyc3.digitaloceanspaces.com
# Must match the endpoint's region.
STORAGE_S3_REGION=nyc3
# Pre-create the bucket so the api never has to call MakeBucket at boot.
STORAGE_S3_BUCKET=example-video-media
# Spaces key pair, scoped to this Space. SECRETS — never commit or log them.
STORAGE_S3_ACCESS_KEY=<your Spaces access key>
STORAGE_S3_SECRET_KEY=<your Spaces secret key>
# Correct for Spaces and AWS (virtual-host addressing over TLS). Only MinIO-style
# stores need FORCE_PATH_STYLE=true.
STORAGE_S3_USE_SSL=true
STORAGE_S3_FORCE_PATH_STYLE=false

# Media garbage collection. Once a day one instance lists everything under the six
# media prefixes and DELETES every object no database row references — that is how
# a deleted video's HLS ladder stops billing. Both knobs are boot-baked (not in the
# admin settings overlay) because the operation is irreversible.
#   false = the daily worker never starts. The admin endpoint still works, so an
#   operator can still sweep by hand. Turn it off while migrating buckets.
MEDIA_GC_ENABLED=true
# Circuit breaker, 0-100. A destructive sweep that finds more than this share of
# what it scanned to be orphans deletes NOTHING and reports why: that shape is what
# a wrong reference set looks like (a half-restored database, a bucket that is not
# this instance's, a migration in flight). Sweeps of <=100 orphans are exempt.
# 0 = report but never delete; 100 = no ratio limit.
MEDIA_GC_MAX_ORPHAN_PERCENT=25
# NOTE (s3 only): the api stamps `.vidra/owner` with this install's identity and
# REFUSES to delete from a bucket it cannot establish as its own — one that already
# held objects when Vidra first pointed at it, or one carrying another install's
# marker. That is deliberate: it is what keeps a shared or pre-populated bucket from
# being emptied within 24h. If the media really is yours, adopt it once as an admin:
#   POST /api/v1/admin/media/gc/adopt-bucket
# `vidra doctor` reports it under "bucket ownership". See vidra-core
# docs/operations.md, "Media garbage collection".

# ------------------------------------------------------------------------------
# Moving the media store (storage migration) — LEAVE UNSET unless you are moving
# ------------------------------------------------------------------------------
# Set these only to move an existing library to another store (local disk -> S3,
# bucket -> bucket, provider -> provider). Empty (the default) means the feature
# is off entirely: no second backend is built and no workers start.
#
# The api copies every object into the target, proves each copy by reading it
# back out and re-hashing it there, and serves from BOTH stores while the move is
# in flight. Object keys never change, so the IPFS pin ledger needs no migration.
# Destructive media GC is forced to dry-run for the duration.
#
# Empty | s3 | local.
STORAGE_MIGRATION_TARGET_BACKEND=
# For s3 — the same shape as the STORAGE_S3_* block above. Host only, no scheme.
# The key pair is a SECRET, same rules as STORAGE_S3_ACCESS_KEY/SECRET_KEY.
#STORAGE_MIGRATION_TARGET_S3_ENDPOINT=nyc3.digitaloceanspaces.com
#STORAGE_MIGRATION_TARGET_S3_REGION=nyc3
#STORAGE_MIGRATION_TARGET_S3_BUCKET=example-video-media-new
#STORAGE_MIGRATION_TARGET_S3_ACCESS_KEY=<destination access key>
#STORAGE_MIGRATION_TARGET_S3_SECRET_KEY=<destination secret key>
#STORAGE_MIGRATION_TARGET_S3_USE_SSL=true
#STORAGE_MIGRATION_TARGET_S3_FORCE_PATH_STYLE=false
# For local.
#STORAGE_MIGRATION_TARGET_LOCAL_ROOT=/srv/new-media
#
# AT CUTOVER YOU SWAP BOTH BLOCKS. Once the campaign reports `synced`, point
# STORAGE_* at the NEW store and STORAGE_MIGRATION_TARGET_* at the OLD one, then
# restart. That swap is how the api learns the cutover happened AND what gives it
# a handle on the store it will later empty. Swap only STORAGE_* and the campaign
# stalls with an explanation and deletes nothing — which is the correct outcome.
#
# How long the OLD store keeps its copies after cutover. This is the undo window:
# until it elapses, reverting is a restart, not a restore. Default 168 (a week).
#STORAGE_MIGRATION_GRACE_HOURS=168
# Start/watch/cancel: POST|GET /api/v1/admin/storage/migrations (admin, audited).
# Full runbook: vidra-core docs/operations.md, "Moving the media store".

# ------------------------------------------------------------------------------
# Transcoding
# ------------------------------------------------------------------------------
# ffmpeg runs INSIDE the api container. One TargetAll job on a 1080p source is 12
# full-source encode passes, so size the droplet for it (see the sizing table in
# deploy/README.md) and tune transcoding_threads / transcoding_concurrency from
# the admin UI at runtime — no restart needed.
TRANSCODING_ENABLED=true
# Optional progressive VP9/WebM alternate per video. Roughly doubles encode cost.
TRANSCODING_VP9_ENABLED=false
# Packaging format for NEW transcodes:
#   cmaf   (default) ONE set of fMP4 segments addressed by both a DASH MPD and
#          HLS playlists. Half the storage of the old two-tree shape, and the
#          only format that can carry HEVC/AV1 or a hardware encoder.
#   ts     the frozen MPEG-TS compatibility path: H.264 only, software only, one
#          rendition directory per height. Keep it only for genuinely ancient HLS
#          clients that cannot read fMP4.
#
# THIS IS THE ROLLBACK, and it is config-only: it changes what NEW transcodes
# produce, while every already-packaged video keeps serving from the format
# recorded against it. Nothing is re-encoded in either direction, so switching
# back and forth costs a restart and no data migration.
#
# Setting this to ts while TRANSCODING_HEVC_ENABLED, TRANSCODING_AV1_ENABLED or
# TRANSCODING_HW is on is a BOOT FAILURE naming the conflict, not a silently
# ignored setting — rolling the packager back means turning those off too.
TRANSCODING_PACKAGER=cmaf
# The extra codecs the paragraph above names. Each one adds a WHOLE SECOND (and
# third) encoding of every ladder rung to the CMAF tree beside the H.264 compat
# floor that every client can play — HEVC/H.265 for Safari and modern TVs, AV1
# for browsers that have it. Storage and encode time go up roughly in proportion
# to how many you turn on; nothing is re-encoded retroactively, so enabling one
# changes new uploads only.
#
# Both are CMAF-ONLY: with TRANSCODING_PACKAGER=ts the api refuses to boot rather
# than quietly ship an H.264-only tree, because the MPEG-TS rollback path cannot
# express two encodings of the same resolution. Both are also boot-probed against
# the image's ffmpeg (libx265 / libsvtav1 — the shipped image has both), so a
# rebuilt image missing an encoder is a startup failure, not a surprise later.
# Leave them commented and an ordinary install produces exactly the H.264 ladder
# it always did.
#TRANSCODING_HEVC_ENABLED=false
#TRANSCODING_AV1_ENABLED=false
# Encode the H.264 rungs on a GPU instead of the CPU:
#   off | vaapi | qsv | nvenc | videotoolbox
# Off by default, and opt-in BY NAME — there is deliberately no "auto". Whether a
# backend works is a property of THIS HOST (a droplet with no GPU, a container
# that was never given /dev/dri, and a GPU instance all run the same image), so a
# pipeline that chose one by looking around would re-tune the whole deployment's
# picture quality the first time a device node moved.
#
# Don't guess: run `vidra doctor` and read the "hardware transcode" line. It says
# which backends are usable against the api CONTAINER's ffmpeg and this host's
# devices, and it never fails — encoding on the CPU is the correct configuration
# for most deployments, not a missing one.
#
#   vaapi   the only backend the shipped image can do (its ffmpeg has h264_vaapi
#           and hevc_vaapi, and has NO *_qsv and NO *_nvenc). Also needs the
#           render node mapped into the api service:
#             devices: ["/dev/dri:/dev/dri"]
#           plus the host's `video` and `render` group IDs via group_add. See the
#           commented exemplars in vidra-core's docker-compose.yml — and note
#           that this hands the container direct GPU access, which is a real
#           privilege surface and not for shared machines.
#   qsv     Intel Quick Sync. Needs an ffmpeg built with oneVPL: rebuild the image.
#   nvenc   NVIDIA. Needs nvidia-container-toolkit AND a rebuilt ffmpeg.
#
# The api probes ffmpeg at boot and refuses to start if the encoder is missing.
# What it CANNOT check is whether the device was mapped in — that fails per job,
# and the error names this variable when it does. There is no automatic fallback
# to the CPU on purpose: a deployment that silently fell back would look healthy
# while every video cost several times its budgeted encode time. Setting this back
# to off is config-only; every already-encoded video keeps serving untouched.
TRANSCODING_HW=off
# Which DRM render node vaapi/qsv use. Uncomment only on a host with more than one
# GPU — an iGPU beside a discrete card has renderD129 as well, and the pipeline
# cannot pick for you. Leave it unset for nvenc and videotoolbox, which name no
# device: the api refuses to boot rather than ignore a path you wrote.
#TRANSCODING_HW_DEVICE=/dev/dri/renderD128
# Write the ladder straight into object storage through the loopback signing
# sidecar instead of staging it on the scratch volume. A TRADE, not a free win:
# the pipeline reads its own output back to build the progressive downloads, so
# those reads become object-store range requests. Turn it on where scratch disk
# is scarce and egress is cheap or CDN-fronted (Backblaze B2 via the Bandwidth
# Alliance, say); leave it off where egress is metered and disk is plentiful.
# Worth nothing at all unless STORAGE_BACKEND=s3.
#TRANSCODING_STREAM_OUTPUT=false
# Free-space floor in MiB on the transcode scratch filesystem (TMPDIR) below
# which the worker claims no new job. A transcode writes several times its
# source before anything is uploaded, and on a single-disk droplet that volume
# shares a filesystem with the Postgres data directory — so filling it does not
# merely fail a job, it stops the database accepting writes. Jobs deferred for
# space stay pending and do NOT spend their retry budget. 0 keeps the built-in
# default of 10 GiB; raise it if your media and your database share a disk.
#TRANSCODING_MIN_FREE_SCRATCH_MB=0
# Publish-after-transcode safety valve: how long a video may sit waiting on its
# transcode before the stuck-hold sweeper publishes it from the ORIGINAL anyway
# (a CAS transition, so a transcode that finishes later still promotes cleanly).
# This is what stops a crashed or OOM-killed worker from hiding a creator's
# video forever. Lowering it shortens that window at the cost of publishing
# un-laddered sooner.
#TRANSCODE_HOLD_TIMEOUT=12h

# ------------------------------------------------------------------------------
# Malware scanning (ClamAV)
# ------------------------------------------------------------------------------
# OFF by default because clamd is not free: it loads the full signature database
# into RAM and holds it resident (~1.5-2 GiB), and it lives in a compose profile
# that is not started by default — enabling the flag while pointing at a host that
# does not exist is a boot failure, which is exactly what the previous version of
# this template shipped.
#
# To turn it on, uncomment BOTH lines below, add --profile scan to every compose
# command, and add ~2 GB of RAM to the droplet:
#   MALWARE_SCAN_ENABLED=true
#   CLAMAV_ADDR=clamav:3310      # `clamav` is the compose SERVICE NAME
# The default MALWARE_SCAN_MODE=fail-closed means unscannable media is not
# published; infected media always fails, in every mode.
MALWARE_SCAN_ENABLED=false

# ------------------------------------------------------------------------------
# Feature flags (boot-time seeds; admins change them live in the admin UI)
# ------------------------------------------------------------------------------
# Live streaming's code default follows the ingest config (since core#121): left
# unset, it is ON only when LIVE_RTMP_URL is set — an enabled-but-unconfigured
# live is a dead-stream trap (the UI hides the server-URL row, so every creator
# would get a stream key pointing nowhere, with no error). The explicit false
# here is kept for clarity: turn it on only once an ingest is actually
# provisioned (then set LIVE_RTMP_URL and LIVE_INGEST_SECRET).
FEATURE_LIVE_ENABLED=false
FEATURE_UPLOADS_ENABLED=true
FEATURE_IMPORTS_ENABLED=true
FEATURE_COMMENTS_ENABLED=true
# When true, uploads by non-privileged users park in 'quarantined' for moderator
# approval instead of publishing. A useful lever for an open public launch.
QUARANTINE_NEW_UPLOADS=false

# LIVE_INGEST_SECRET is the shared secret the RTMP media server presents on the
# internal /live/ingest hooks; empty DISABLES those hooks (404). Only needed with
# FEATURE_LIVE_ENABLED=true and the media profile running.
#   generate: openssl rand -hex 24
# LIVE_INGEST_SECRET=

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
# Prometheus RED metrics at GET /metrics.
# PREREQUISITE: /metrics is root-mounted with NO authentication. It is safe here
# only because the api port is published on 127.0.0.1 and the reverse proxy does
# not route /metrics to the api (deploy/Caddyfile sends unmatched paths to the
# frontend and explicitly 404s this one). Confirm that before enabling, and scrape
# it over the compose network or from the loopback interface.
METRICS_ENABLED=true
# Distributed tracing. Off unless a collector exists — with OTEL_ENABLED=true the
# endpoint becomes REQUIRED and boot fails without it. The default protocol is
# grpc (port 4317); http/protobuf uses 4318.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# The api and the frontend must report DIFFERENT service names or their spans
# merge into one indistinguishable service.
# OTEL_SERVICE_NAME=vidra-core
# FRONTEND_OTEL_SERVICE_NAME=vidra-user

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
# Required for password reset and email verification. DigitalOcean blocks outbound
# port 25 on new accounts — use a relay on 587 with STARTTLS + AUTH, and publish
# SPF/DKIM for the SMTP_FROM domain or the mail is silently spam-filed.
# SMTP_HOST and SMTP_FROM are REQUIRED when MAIL_ENABLED=true.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SECRET — never commit a real value.
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# Dev/test seams — MUST stay false in production
# ------------------------------------------------------------------------------
# DEV_MAIL_CAPTURE_ENABLED exposes GET /api/v1/dev/email-token, which returns a
# live password-reset token for ANY address with no authentication. It is set true
# in env/qa.env.example and by the e2e Makefile target, so a copy-paste from
# either is one keystroke from full account takeover.
DEV_MAIL_CAPTURE_ENABLED=false
# HTTP_IMPORT_ALLOW_PRIVATE_URLS re-opens the URL-import SSRF hole: it lets the
# importer fetch RFC1918 / loopback / link-local addresses, including the cloud
# metadata service.
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false

# ------------------------------------------------------------------------------
# URL import via yt-dlp (watch-page / platform URLs, e.g. PeerTube /w/ links)
# ------------------------------------------------------------------------------
# Release images v0.1.2+ bake a PINNED yt-dlp binary (publish-container.yml's
# YTDLP_VERSION build-arg); images before that have no binary, so enabling this
# flag on v0.1.1 or older only moves the failure. With the flag false (default),
# resolver=ytdlp imports answer 503 and resolver=auto never falls back to yt-dlp
# — a pasted watch-page URL then fails in the direct resolver with "not an
# accepted video container". Channel sync (CHANNEL_SYNC_ENABLED) additionally
# requires this flag.
YTDLP_IMPORT_ENABLED=false
# YTDLP_MAX_HEIGHT=1080          # cap imported resolution (0 = no cap, else 144..4320)
# YTDLP_TIMEOUT=15m              # hard wall-clock bound per yt-dlp invocation
# YTDLP_PROXY=                   # optional http(s)/socks5 forward proxy for egress

# ------------------------------------------------------------------------------
# Migrating from PeerTube — LEAVE UNSET unless you are moving an instance
# ------------------------------------------------------------------------------
# A ONE-WAY import that reads an existing PeerTube instance's PostgreSQL database
# and its media and maps both into this one. It is READ-ONLY on the source: no
# statement it runs writes there. `vidra setup` asks about all of this behind one
# question, so these lines are as much for that command to fill in as for you.
#
# THESE KEYS DO NOT RUN AN IMPORT. They configure the ADMIN API path and its
# worker; the migration itself is started and watched at
# <PUBLIC_BASE_URL>/admin/import-peertube, once the stack is up and you are
# signed in as admin. That ordering is why `vidra setup` can only write them
# down: at setup time no container exists to reach the source from, so every
# answer below is checked for SHAPE and never for connectivity.
#
# The standalone `peertube-import` CLI in the api image takes its own flags and
# needs none of this. These keys are for the operator who wants the migration
# driven from the admin UI, on a schedule, up to cutover — which is the
# recommended shape: run it repeatedly, then once more at the switchover. Every
# entity already carried across is recorded in a ledger, so a re-run moves only
# what changed, and that re-run IS the cutover downtime.
#
# ENABLING THIS MAKES THE SOURCE DSN REQUIRED. Left false (the default) every
# other line here is inert and the admin endpoints answer 503.
PEERTUBE_IMPORT_ENABLED=false

# The source instance's database, READ-ONLY. Point it at a restored dump or a
# read-only replica, and connect with a least-privilege read-only role — this is
# somebody's production database and the import has no reason to hold a role that
# could write to it.
#
# SECRET: the password is inside the string. Never commit the filled-in file, and
# prefer `vidra setup --peertube-source-url @/path/to/dsn` to typing it on a
# command line, which is world-readable in `ps` and lands in the shell history.
# Both dialects work: postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require, or
# the keyword form (host=HOST user=readonly dbname=peertube_prod).
PEERTUBE_SOURCE_DATABASE_URL=

# Where the SOURCE instance's media lives: local | s3.
#
#   local  a copy of its media tree, readable by the api container. NOTE that
#          "readable by the api container" is a bind mount YOU have to add:
#          nothing in this deployment mounts the path below, so a directory that
#          exists only on the host is one the importer cannot see. Add it to the
#          api service — and to `worker` if you run the split topology — as a
#          read-only mount at the same path.
#   s3     the source instance's own object store, addressed by the block below.
#
# ONE MEDIA FAMILY IS IN NEITHER: account and channel avatars and banners stay on
# the source host's local disk whatever its storage settings say, so the importer
# fetches those over HTTP from the source's public origin, which it derives from
# the source's own actor URLs. There is nothing to configure for it.
PEERTUBE_SOURCE_STORAGE_BACKEND=local
# For local — the directory that copy is mounted at, read-only. Path-traversal
# guarded on every read.
PEERTUBE_SOURCE_STORAGE_LOCAL_ROOT=

# For s3 — the same shape as the STORAGE_S3_* block above, addressing the SOURCE
# instance's store. Host only, no scheme; the key pair is a SECRET.
PEERTUBE_SOURCE_S3_ENDPOINT=
PEERTUBE_SOURCE_S3_BUCKET=
PEERTUBE_SOURCE_S3_ACCESS_KEY=
PEERTUBE_SOURCE_S3_SECRET_KEY=
PEERTUBE_SOURCE_S3_REGION=
# Correct for AWS/Spaces/B2 (virtual-host addressing over TLS). A MinIO-style
# source store is the one that needs FORCE_PATH_STYLE=true.
PEERTUBE_SOURCE_S3_USE_SSL=true
PEERTUBE_SOURCE_S3_FORCE_PATH_STYLE=false

# What an import does with the source's media. The admin screen can override it
# per run; this is the default it opens on.
#
#   copy       (default) stream every source object into THIS instance's storage.
#              The answer for a real migration: when it finishes, the source can
#              be switched off.
#   reference  record the source's object keys and serve from the SOURCE bucket.
#              Nothing is copied, so it is fast — and it TIES THIS INSTANCE'S
#              PLAYBACK TO THAT BUCKET permanently. The old instance's storage can
#              never be turned off, this instance's STORAGE_* must already point
#              at the same bucket, and media GC must never adopt it (see the
#              bucket-ownership note in the storage section: that marker is what
#              stops one install emptying another's bucket). Choose it only if
#              that store is one you are keeping.
#   none       metadata only — a rehearsal of the mapping.
PEERTUBE_IMPORT_MEDIA_MODE=copy

# What an import does when a source entity collides with a row this instance
# already has (a username, a channel handle, an email, a playlist slug):
#
#   skip    (default, safest) leave the existing row alone and map the source
#           entity onto it, so its children still resolve.
#   rename  import it under a de-duplicated identifier, keeping both.
#   merge   attach the source entity's children to the existing row.
#   fail    abort the whole import on the first collision, for an operator who
#           wants a guaranteed-clean target and will resolve them by hand.
PEERTUBE_IMPORT_CONFLICT_POLICY=skip

# ------------------------------------------------------------------------------
# vidra-search (internal service — never browser-facing)
# ------------------------------------------------------------------------------
# SEARCH_HTTP_PORT IS DELIBERATELY ABSENT. Setting it publishes the internal search
# service on a host port, which is exactly what this deployment must not do —
# docker-compose.prod.yml removes the publish with `ports: !reset []` on that
# service. (It must be `!reset`: Compose merges sequence fields across a -f
# chain, so a plain `ports: []` in an overlay appends nothing and the base
# publish survives. `!reset` needs Compose >= 2.24.)
#
# SEARCH_SERVICE_URL MUST BE SET HERE. In local development the api gets it from
# the auto-loaded docker-compose.override.yml, but a production deploy uses an
# explicit `-f docker-compose.yml -f docker-compose.prod.yml` chain, and an
# explicit chain DISABLES override auto-loading. Leaving it unset is not a visible
# failure: search degrades silently to local SQL and nobody notices.
SEARCH_SERVICE_URL=http://search:8080
# Shared HMAC secret for core<->search auth. It must equal the search service's
# INTERNAL_SECRET; the single substitution below feeds both sides, so they always
# match. Required at >=32 characters in production whenever SEARCH_SERVICE_URL is
# set — a half-configured deployment fails loudly at boot rather than silently.
# Rotating it requires changing both services in the SAME deploy.
#   generate: openssl rand -hex 32
SEARCH_INTERNAL_SECRET=<generate: openssl rand -hex 32>

# ------------------------------------------------------------------------------
# ActivityPub federation (off)
# ------------------------------------------------------------------------------
# When enabled, PUBLIC_BASE_URL must be an https origin with no path (it already
# is, above) and FEDERATION_KEY_KEK becomes REQUIRED in production.
# FEDERATION_KEY_KEK is base64 of exactly 32 bytes and is DESTRUCTIVE TO ROTATE:
# it seals actor private keys already in the database, and ATPROTO_KEY_KEK falls
# back to it, so rotating it silently breaks linked Bluesky credentials too.
#   generate: openssl rand -base64 32
FEDERATION_ENABLED=false
# FEDERATION_KEY_KEK=

# ------------------------------------------------------------------------------
# CDN delivery (off)
# ------------------------------------------------------------------------------
# Enabling a CDN is a configuration act, not a code change. Everything below has
# a safe default in the compose anchor, so leaving this whole block commented is
# a valid production configuration and the API serves every byte itself.
#
# TWO SWITCHES, BOTH REQUIRED. A base URL alone does nothing: the runtime setting
# `delivery_cdn_enabled` (Admin -> Advanced -> delivery, default OFF) is read per
# request so you can cut a misbehaving CDN out without a restart. The env var
# says a CDN EXISTS; the setting says USE it.
#
# WHAT THE CDN MUST PULL FROM — the one way to get this wrong. Vidra resolves a
# source per OBJECT KEY, so it builds <base>/<object key>. That means the CDN
# origin must be the object store (or a static server rooted at the media
# directory) — NOT the Vidra API origin, which does not serve those paths and
# will 404 every one of them. Nothing can verify this for you: a third-party 404
# is indistinguishable from a cold cache, so a wrong origin looks like a CDN that
# is merely slow to warm.
#
# WHAT A CDN CAN SERVE: public, published, uncredentialed media only. Private,
# password-gated, unlisted-cover, scheduled and quarantined bytes are
# structurally origin-only and are never handed to a CDN. That is enforced, not
# advisory.
#DELIVERY_CDN_BASE_URL=https://cdn.example.com

# Purge. Configure this if you configure a CDN: an object key you cannot
# invalidate is a stale public copy you cannot recall, and Vidra treats "CDN
# configured, purge not" as an ERROR rather than pretending eviction succeeded.
# The URL is a template — {url}, {url_encoded} and {key} are substituted. The
# token is a SECRET, sent as the named header. HTTP 404 counts as success (the
# object was not cached).
#DELIVERY_CDN_PURGE_URL=https://api.example.com/purge?path={url_encoded}
#DELIVERY_CDN_PURGE_METHOD=POST
#DELIVERY_CDN_PURGE_HEADER=Authorization
#DELIVERY_CDN_PURGE_TOKEN=<your CDN API token>
#DELIVERY_CDN_PURGE_TIMEOUT=10s

# ------------------------------------------------------------------------------
# Content protection / DRM (off)
# ------------------------------------------------------------------------------
# OFF by default and NOT USABLE YET: `none` is no content protection anywhere,
# and nothing encrypts media in this build — the phase-5 provider seam and its
# key store exist, the packaging step that would use them does not. The only
# other accepted value, `clearkey-test`, is EME ClearKey and the name is the
# warning: it serves the content key in the clear to any authorised viewer,
# proving the license path while protecting nothing (the admin Infrastructure
# page's DRM row says exactly this while it is active). A misspelled value
# refuses to boot rather than silently falling back to `none`.
#
# DRM_KEY_KEK seals content keys at rest (base64 of exactly 32 bytes). It is a
# SECRET, REQUIRED by any provider other than `none`, REFUSED alongside `none`,
# and — unlike the other KEKs — it does NOT fall back to FEDERATION_KEY_KEK: a
# content key is a different trust domain from an actor key. Rotating it is
# unrecoverable; `vidra setup` demands --rotate DRM_KEY_KEK --yes-i-know.
#   generate: openssl rand -base64 32
#DRM_PROVIDER=none
#DRM_KEY_KEK=
