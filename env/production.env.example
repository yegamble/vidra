# ==============================================================================
# VIDRA — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to env/production.env and fill in. That file is gitignored; this one is
# committed, so it must never contain a real secret.
#
#   cp env/production.env.example env/production.env
#   $EDITOR env/production.env
#   git check-ignore -v env/production.env      # MUST match, or stop
#
# HOW THIS FILE REACHES THE CONTAINERS
# ------------------------------------
# It is passed with `--env-file`, which feeds compose VARIABLE SUBSTITUTION only.
# A key reaches a container solely because that service's `environment:` map in
# docker-compose.yml (or vidra-core/docker-compose.yml) names it — there is no
# env_file: anywhere in the stack and no wildcard passthrough. Adding a key here
# that has no ${...} consumer in a compose file does NOTHING. If you need one,
# add it to the api service's environment map first.
#
# `--env-file` DOES propagate into the `include:`d vidra-core compose file, and it
# WINS for every key it defines. It does NOT, however, replace vidra-core/.env
# wholesale: any key this file leaves unset still falls through to that file if it
# exists. A host that only ever ran ./bootstrap.sh has no vidra-core/.env (it is
# gitignored and never cloned), which is the expected state — but if you are
# deploying from a directory that was also used for development, DELETE
# vidra-core/.env first. A stale developer DATABASE_URL pointing at localhost is
# the failure mode: it would land inside the api container, where localhost is the
# container itself.
#   verify: docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#             --env-file env/production.env --profile core --profile frontend config
#
# Promotion rule: deploy the EXACT image tags staging validated.
# Canonical matrix: .ralph/specs/environments.md
#
# BEFORE FIRST BOOT, replace every <generate: ...> placeholder below. They are
# deliberately malformed so the api refuses to start rather than booting with a
# value that is published in this repository.
# ==============================================================================

VIDRA_ENV=production

# ------------------------------------------------------------------------------
# Release tags — which images to pull
# ------------------------------------------------------------------------------
# Consumed by docker-compose.prod.yml (image: ghcr.io/.../vidra-core:${VIDRA_CORE_TAG}).
# They are REQUIRED there: rendering fails if they are unset, which is deliberate —
# an untagged production deploy has nothing to roll back to. Roll back by rewriting
# these to the previous tag and re-running the deploy.
VIDRA_CORE_TAG=v0.1.0
VIDRA_USER_TAG=v0.1.0
VIDRA_SEARCH_TAG=v0.1.0

# OPTIONAL. The GHCR owner the three images are pulled from — the overlay
# expands ghcr.io/${VIDRA_IMAGE_OWNER:-yegamble}/vidra-core etc. Leave it unset
# for the upstream images; set it only when deploying images published from a
# fork (your GitHub username or org, lowercase — GHCR paths are lowercase).
# Forks also set GITHUB_OWNER (deploy/release.sh) and VIDRA_GH_OWNER
# (bootstrap.sh) to the same owner.
# VIDRA_IMAGE_OWNER=yegamble

# ------------------------------------------------------------------------------
# Origin topology — ONE domain, routed by path
# ------------------------------------------------------------------------------
# PUBLIC_BASE_URL is used for BOTH halves of the site: watch/embed/channel links
# in RSS, oEmbed and the sitemap, AND the API-side callback/identity URLs (OAuth
# redirect_uri, NodeInfo, ActivityPub + atproto actor ids). A split
# api.example.com / example.com deployment therefore cannot be correct with one
# value — pointing it at the API origin 404s every feed link, pointing it at the
# web origin breaks OAuth and federation.
#
# The fix is topological: serve everything from ONE origin and let the reverse
# proxy route /api/*, /healthz, /readyz, /version, /sitemap.xml, /feeds/*,
# /nodeinfo/* and /.well-known/* to the api and everything else to the frontend
# (see deploy/Caddyfile). Frontend /videos/{id} and api /api/v1/videos/{id} do
# not collide. CORS becomes same-origin as a bonus.
#
# Must be https in production and must NOT include a path or trailing slash.
PUBLIC_BASE_URL=https://example.com

# The origin the BROWSER bundle calls. Same value, same reason.
# BUILD-TIME CAVEAT: Next.js inlines NEXT_PUBLIC_* into the client bundle at image
# BUILD time, so for a PULLED image this value is already baked in — it comes from
# the repository variable in vidra-user's publish workflow. Setting it here only
# affects a locally built frontend image. Keep the two in agreement.
NEXT_PUBLIC_API_BASE_URL=https://example.com

# Explicit, comma-separated allow-list. Wildcards are rejected in production.
# Same-origin under the single-domain topology, but a valid value is still required.
CORS_ALLOWED_ORIGINS=https://example.com

# Host ports the reverse proxy connects to. docker-compose.prod.yml publishes both
# on 127.0.0.1 ONLY — a host firewall does NOT filter Docker-published ports
# (Docker's DOCKER-USER iptables chain runs ahead of ufw), so the loopback bind is
# the actual control.
HTTP_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Secrets — replace every placeholder; never commit the filled-in file
# ------------------------------------------------------------------------------
# JWT signing key for access tokens (HS256).
#   generate: openssl rand -base64 48
# Left EMPTY rather than pre-filled: an empty value falls back to the built-in dev
# constant, which the api REFUSES in production ("JWT_SECRET must be set in
# production"), as it also refuses anything under 32 bytes. That is a loud boot
# failure, which is what you want from a forgotten secret.
# Safe to rotate — it just logs everyone out.
JWT_SECRET=

# Base64 of exactly 32 bytes. Envelope-encrypts TOTP shared secrets at rest.
#   generate: openssl rand -base64 32
# IF THIS IS UNSET (and FEDERATION_KEY_KEK is too) EVERY TOTP SECRET IS STORED IN
# PLAINTEXT. There is no boot error for that case — only a warning in the api log
# — which is why this template ships a deliberately invalid placeholder rather
# than an empty value: a malformed KEK fails validation loudly.
# DESTRUCTIVE TO ROTATE: it seals rows already in the database, and no re-wrap
# job exists.
MFA_KEY_KEK=<generate: openssl rand -base64 32>

# Bundled PostgreSQL. Use HEX, not base64: this password is substituted into a
# postgres:// DSN, and base64's + and / characters would need percent-encoding.
#   generate: openssl rand -hex 32
# docker-compose.prod.yml references it as `${POSTGRES_PASSWORD:?...}`, so an
# env file that omits or blanks the key fails the render — the base file's dev
# default (`vidra`) can never silently become the production database password.
# Left EMPTY like JWT_SECRET/REDIS_PASSWORD above: `:?` fails on an empty value
# too, so an unedited copy is caught by `make prod-config` / deploy.sh's
# pre-flight. NOTE: on a host with an EXISTING database volume, set this to the
# database's CURRENT password — the value only initializes a fresh volume (see
# deploy/README.md).
POSTGRES_USER=vidra
POSTGRES_PASSWORD=
POSTGRES_DB=vidra

# Bundled Redis. docker-compose.prod.yml starts redis with
# --requirepass ${REDIS_PASSWORD} and derives both clients' DSNs from it
# (redis://:PASSWORD@redis:6379/0 for the api, /1 for search), so this ONE value
# is all that is needed — do not hand-write REDIS_URL as well, or the two drift
# and every command comes back NOAUTH. Same hex rationale as above.
#   generate: openssl rand -hex 32
# Left EMPTY for the same reason as JWT_SECRET above: docker-compose.prod.yml
# references it as `${REDIS_PASSWORD:?...}`, and that form fails the render on an
# EMPTY value as well as an unset one — so a copied-but-unedited env file is
# caught by `make prod-config` / deploy.sh's pre-flight instead of starting a
# Redis whose password is the literal string "<generate: openssl rand -hex 32>".
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Database DSN overrides (managed-service path)
# ------------------------------------------------------------------------------
# Unset, the api and the migrate job both build a DSN for the compose-network
# postgres from POSTGRES_USER/PASSWORD/DB above — that is the recommended launch
# configuration (bundled Postgres 18 on the droplet plus a nightly dump off-box).
#
# To move to a managed database later, set DATABASE_URL: this ONE value is the
# DSN for the api, the search service, and BOTH migration one-shots — search
# shares the same database in a separate `search` schema, so one pg_dump still
# covers both. (There used to be a second SEARCH_MIGRATE_DATABASE_URL here,
# needed only to append &x-migrations-table=vidra_search_migrations. The search
# migrator now compiles that ledger name in, so the variable is gone; a leftover
# line in an old env file is simply unused.)
# Managed Postgres rejects sslmode=disable — use require.
# DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-nyc3-00000-do-user-0-0.m.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@db-redis-nyc3-00000-do-user-0-0.m.db.ondigitalocean.com:25061/0
# The search service keeps its own Redis DB INDEX — never point it at /0.
# SEARCH_REDIS_URL=rediss://default:PASSWORD@db-redis-nyc3-00000-do-user-0-0.m.db.ondigitalocean.com:25061/1

# ------------------------------------------------------------------------------
# Instance identity
# ------------------------------------------------------------------------------
# MUST be overridden: the built-in default is the literal "Vidra (dev)", and it is
# served publicly at GET /api/v1/instance, shown in NodeInfo, and used as the
# default TOTP issuer label in every user's authenticator app.
INSTANCE_NAME=Example Video

# Optional about/legal metadata, served publicly at GET /api/v1/instance. Emitted
# verbatim — supply full absolute URLs. The contact address also appears in NodeInfo.
INSTANCE_DESCRIPTION=
INSTANCE_TERMS_URL=
INSTANCE_PRIVACY_URL=
INSTANCE_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# Registration — read the "First boot" section of deploy/README.md BEFORE changing
# ------------------------------------------------------------------------------
# The FIRST account created on an empty users table is granted admin, on every
# signup path, and there is no CLI to create or promote an admin — recovery from a
# signup bot claiming ownership is raw SQL. So: ship false, bring the stack up,
# register the owner account yourself over the loopback port (or before DNS
# propagates), verify the admin surface, and only THEN set this true and re-deploy.
REGISTRATION_ENABLED=false
# Once registration is open, require an admin to approve each signup (the
# registration approval queue).
REGISTRATION_REQUIRE_APPROVAL=false

# ------------------------------------------------------------------------------
# Rate limits, timeouts and upload sizing
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Blanket per-IP budget for the /api/v1 surface, per RATE_LIMIT_WINDOW (1m).
RATE_LIMIT_REQUESTS=120
# Media GETs (thumbnails, HLS, storyboards, downloads, avatars) get their own much
# larger budget — one home page is a feed call plus ~20 thumbnails and HLS playback
# adds ~10 segments/minute, so they must not share the API bucket.
MEDIA_RATE_LIMIT_REQUESTS=3000
# The auth endpoints keep their strict 10-per-window default. Do NOT raise it.

# Per-request context deadline for ordinary API work.
HTTP_REQUEST_TIMEOUT=30s
# The separate, much longer deadline for the streaming routes (chunk PUTs, direct
# uploads, media GETs). Those are bounded by the client's link speed, not by
# server work: 1h covers a 2 GiB upload at ~4.7 Mbit/s.
HTTP_STREAM_REQUEST_TIMEOUT=1h

# Largest single original-file upload accepted.
# SIZING COUPLING: transcode scratch needs roughly 4x this per concurrent job
# (ffmpeg runs inside the api container). With 2G that is ~8 GB of scratch —
# budget the transcode_tmp volume accordingly or the disk fills.
UPLOAD_MAX_SIZE=2G

# Default per-user storage quota in BYTES. The code default is 0 = UNLIMITED,
# which is the wrong answer for any instance that accepts signups. 5 GiB below;
# admins can override per account (PATCH /api/v1/admin/users/{id}).
# CAVEAT: the quota sums video_files only — the HLS ladder in video_renditions is
# not counted, so real storage consumption exceeds this figure.
INSTANCE_DEFAULT_QUOTA_BYTES=5368709120

# ------------------------------------------------------------------------------
# Media storage — DigitalOcean Spaces (S3-compatible)
# ------------------------------------------------------------------------------
# Do NOT use STORAGE_BACKEND=local unless docker-compose.prod.yml mounts a volume
# at /app/data: the local root otherwise lives on the container's writable layer,
# so `up -d` destroys the media while the database rows survive pointing at nothing.
STORAGE_BACKEND=s3
# HOST ONLY — no scheme. A value containing "://" is rejected outright; the
# http/https choice is STORAGE_S3_USE_SSL. Use the regional endpoint, e.g.
# nyc3.digitaloceanspaces.com / fra1.digitaloceanspaces.com / sgp1....
STORAGE_S3_ENDPOINT=nyc3.digitaloceanspaces.com
# Must match the endpoint's region.
STORAGE_S3_REGION=nyc3
# Pre-create the bucket so the api never has to call MakeBucket at boot.
STORAGE_S3_BUCKET=example-video-media
# Spaces key pair, scoped to this Space. SECRETS — never commit or log them.
STORAGE_S3_ACCESS_KEY=<your Spaces access key>
STORAGE_S3_SECRET_KEY=<your Spaces secret key>
# Correct for Spaces and AWS (virtual-host addressing over TLS). Only MinIO-style
# stores need FORCE_PATH_STYLE=true.
STORAGE_S3_USE_SSL=true
STORAGE_S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Transcoding
# ------------------------------------------------------------------------------
# ffmpeg runs INSIDE the api container. One TargetAll job on a 1080p source is 12
# full-source encode passes, so size the droplet for it (see the sizing table in
# deploy/README.md) and tune transcoding_threads / transcoding_concurrency from
# the admin UI at runtime — no restart needed.
TRANSCODING_ENABLED=true
# Optional progressive VP9/WebM alternate per video. Roughly doubles encode cost.
TRANSCODING_VP9_ENABLED=false

# ------------------------------------------------------------------------------
# Malware scanning (ClamAV)
# ------------------------------------------------------------------------------
# OFF by default because clamd is not free: it loads the full signature database
# into RAM and holds it resident (~1.5-2 GiB), and it lives in a compose profile
# that is not started by default — enabling the flag while pointing at a host that
# does not exist is a boot failure, which is exactly what the previous version of
# this template shipped.
#
# To turn it on, uncomment BOTH lines below, add --profile scan to every compose
# command, and add ~2 GB of RAM to the droplet:
#   MALWARE_SCAN_ENABLED=true
#   CLAMAV_ADDR=clamav:3310      # `clamav` is the compose SERVICE NAME
# The default MALWARE_SCAN_MODE=fail-closed means unscannable media is not
# published; infected media always fails, in every mode.
MALWARE_SCAN_ENABLED=false

# ------------------------------------------------------------------------------
# Feature flags (boot-time seeds; admins change them live in the admin UI)
# ------------------------------------------------------------------------------
# Live streaming defaults to ON in code, which is a trap in production: the RTMP
# ingest lives in the `media` compose profile that this deployment does not start,
# and with LIVE_RTMP_URL empty the UI HIDES the server-URL row — so every creator
# would get a stream key pointing nowhere, with no error. Turn it on only once an
# ingest is actually provisioned (then set LIVE_RTMP_URL and LIVE_INGEST_SECRET).
FEATURE_LIVE_ENABLED=false
FEATURE_UPLOADS_ENABLED=true
FEATURE_IMPORTS_ENABLED=true
FEATURE_COMMENTS_ENABLED=true
# When true, uploads by non-privileged users park in 'quarantined' for moderator
# approval instead of publishing. A useful lever for an open public launch.
QUARANTINE_NEW_UPLOADS=false

# LIVE_INGEST_SECRET is the shared secret the RTMP media server presents on the
# internal /live/ingest hooks; empty DISABLES those hooks (404). Only needed with
# FEATURE_LIVE_ENABLED=true and the media profile running.
#   generate: openssl rand -hex 24
# LIVE_INGEST_SECRET=

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
# Prometheus RED metrics at GET /metrics.
# PREREQUISITE: /metrics is root-mounted with NO authentication. It is safe here
# only because the api port is published on 127.0.0.1 and the reverse proxy does
# not route /metrics to the api (deploy/Caddyfile sends unmatched paths to the
# frontend and explicitly 404s this one). Confirm that before enabling, and scrape
# it over the compose network or from the loopback interface.
METRICS_ENABLED=true
# Distributed tracing. Off unless a collector exists — with OTEL_ENABLED=true the
# endpoint becomes REQUIRED and boot fails without it. The default protocol is
# grpc (port 4317); http/protobuf uses 4318.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# The api and the frontend must report DIFFERENT service names or their spans
# merge into one indistinguishable service.
# OTEL_SERVICE_NAME=vidra-core
# FRONTEND_OTEL_SERVICE_NAME=vidra-user

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
# Required for password reset and email verification. DigitalOcean blocks outbound
# port 25 on new accounts — use a relay on 587 with STARTTLS + AUTH, and publish
# SPF/DKIM for the SMTP_FROM domain or the mail is silently spam-filed.
# SMTP_HOST and SMTP_FROM are REQUIRED when MAIL_ENABLED=true.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SECRET — never commit a real value.
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# Dev/test seams — MUST stay false in production
# ------------------------------------------------------------------------------
# DEV_MAIL_CAPTURE_ENABLED exposes GET /api/v1/dev/email-token, which returns a
# live password-reset token for ANY address with no authentication. It is set true
# in env/qa.env.example and by the e2e Makefile target, so a copy-paste from
# either is one keystroke from full account takeover.
DEV_MAIL_CAPTURE_ENABLED=false
# HTTP_IMPORT_ALLOW_PRIVATE_URLS re-opens the URL-import SSRF hole: it lets the
# importer fetch RFC1918 / loopback / link-local addresses, including the cloud
# metadata service.
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false

# ------------------------------------------------------------------------------
# URL import via yt-dlp (watch-page / platform URLs, e.g. PeerTube /w/ links)
# ------------------------------------------------------------------------------
# Release images v0.1.2+ bake a PINNED yt-dlp binary (publish-container.yml's
# YTDLP_VERSION build-arg); images before that have no binary, so enabling this
# flag on v0.1.1 or older only moves the failure. With the flag false (default),
# resolver=ytdlp imports answer 503 and resolver=auto never falls back to yt-dlp
# — a pasted watch-page URL then fails in the direct resolver with "not an
# accepted video container". Channel sync (CHANNEL_SYNC_ENABLED) additionally
# requires this flag.
YTDLP_IMPORT_ENABLED=false
# YTDLP_MAX_HEIGHT=1080          # cap imported resolution (0 = no cap, else 144..4320)
# YTDLP_TIMEOUT=15m              # hard wall-clock bound per yt-dlp invocation
# YTDLP_PROXY=                   # optional http(s)/socks5 forward proxy for egress

# ------------------------------------------------------------------------------
# vidra-search (internal service — never browser-facing)
# ------------------------------------------------------------------------------
# SEARCH_HTTP_PORT IS DELIBERATELY ABSENT. Setting it publishes the internal search
# service on a host port, which is exactly what this deployment must not do —
# docker-compose.prod.yml removes the publish with `ports: !reset []` on that
# service. (It must be `!reset`: Compose merges sequence fields across a -f
# chain, so a plain `ports: []` in an overlay appends nothing and the base
# publish survives. `!reset` needs Compose >= 2.24.)
#
# SEARCH_SERVICE_URL MUST BE SET HERE. In local development the api gets it from
# the auto-loaded docker-compose.override.yml, but a production deploy uses an
# explicit `-f docker-compose.yml -f docker-compose.prod.yml` chain, and an
# explicit chain DISABLES override auto-loading. Leaving it unset is not a visible
# failure: search degrades silently to local SQL and nobody notices.
SEARCH_SERVICE_URL=http://search:8080
# Shared HMAC secret for core<->search auth. It must equal the search service's
# INTERNAL_SECRET; the single substitution below feeds both sides, so they always
# match. Required at >=32 characters in production whenever SEARCH_SERVICE_URL is
# set — a half-configured deployment fails loudly at boot rather than silently.
# Rotating it requires changing both services in the SAME deploy.
#   generate: openssl rand -hex 32
SEARCH_INTERNAL_SECRET=<generate: openssl rand -hex 32>

# ------------------------------------------------------------------------------
# ActivityPub federation (off)
# ------------------------------------------------------------------------------
# When enabled, PUBLIC_BASE_URL must be an https origin with no path (it already
# is, above) and FEDERATION_KEY_KEK becomes REQUIRED in production.
# FEDERATION_KEY_KEK is base64 of exactly 32 bytes and is DESTRUCTIVE TO ROTATE:
# it seals actor private keys already in the database, and ATPROTO_KEY_KEK falls
# back to it, so rotating it silently breaks linked Bluesky credentials too.
#   generate: openssl rand -base64 32
FEDERATION_ENABLED=false
# FEDERATION_KEY_KEK=
