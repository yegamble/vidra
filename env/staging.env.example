# ==============================================================================
# VIDRA — STAGING ENVIRONMENT TEMPLATE
# ==============================================================================
# Staging is PRODUCTION CONFIG WITH THROWAWAY DATA. VIDRA_ENV=production so every
# production-only validation, every fail-closed guard and the Secure-cookie policy
# are exercised here first — if a value is wrong, staging is where it should blow
# up. Same image tags as the production candidate; separate secrets, separate
# domains, separate Space, separate database.
#
#   cp env/staging.env.example env/staging.env
#   $EDITOR env/staging.env
#   git check-ignore -v env/staging.env      # MUST match, or stop
#
# Every field here has the same semantics as in env/production.env.example — read
# that file for the full rationale on each block (in particular, how --env-file
# reaches the containers, and why a stale vidra-core/.env on the deploy host must
# be deleted first). Only the staging-specific deltas are annotated below.
#
# Canonical matrix: .ralph/specs/environments.md
#
# BEFORE FIRST BOOT, replace every <generate: ...> placeholder. They are
# deliberately malformed so the api refuses to start rather than booting with a
# value published in this repository.
# ==============================================================================

VIDRA_ENV=production

# ------------------------------------------------------------------------------
# Release tags
# ------------------------------------------------------------------------------
# STAGING VALIDATES THE EXACT TAGS PRODUCTION WILL RUN. Never point staging at a
# floating tag (:latest, :main) — then "staging passed" says nothing about the
# artifact production pulls, and these six values must stay equal to production's
# three for the same reason. The two migrator tags also have a FLOOR
# (deploy/deploy.sh's MIN_EMBEDDED_MIGRATE_TAG), which is a compatibility bound
# that stays put — these three are the RECOMMENDATION and move every release.
# env/production.env.example carries the full note, including why leaving them
# stale lets a deploy exit 0 on release-old code.
VIDRA_CORE_TAG=v0.6.0
VIDRA_USER_TAG=v0.6.0
VIDRA_SEARCH_TAG=v0.6.0

# OPTIONAL. The GHCR owner the three images are pulled from (see the full note
# in env/production.env.example). Staging must pull from the SAME owner as
# production, or it is not validating the artifact production will run. Forks
# also set GITHUB_OWNER (deploy/release.sh) and VIDRA_GH_OWNER (bootstrap.sh).
# VIDRA_IMAGE_OWNER=yegamble

# ------------------------------------------------------------------------------
# Origin topology — ONE domain, routed by path (same decision as production)
# ------------------------------------------------------------------------------
# PUBLIC_BASE_URL feeds BOTH the watch/embed/feed/sitemap links and the API-side
# OAuth/NodeInfo/ActivityPub identity URLs, so a split api-host/web-host pair
# cannot both be right. Serve everything from one origin and route by path in the
# reverse proxy. Staging must use the SAME topology as production or it is not
# testing the thing that ships. https, no path, no trailing slash.
PUBLIC_BASE_URL=https://stg.example.com
# Baked into the browser bundle at image BUILD time — for a pulled image this
# value comes from the build, not from here. Keep them in agreement.
NEXT_PUBLIC_API_BASE_URL=https://stg.example.com
CORS_ALLOWED_ORIGINS=https://stg.example.com

# Published on 127.0.0.1 only by docker-compose.prod.yml; the reverse proxy is the
# only thing that connects to them.
HTTP_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Secrets — MUST BE DIFFERENT FROM PRODUCTION'S
# ------------------------------------------------------------------------------
# Sharing a secret between staging and production means a staging compromise is a
# production compromise, and it makes staging tokens valid in production.
#
# Empty falls back to the built-in dev constant, which production-mode config
# REFUSES — a loud boot failure rather than a weak key.
#   generate: openssl rand -base64 48
JWT_SECRET=

# Base64 of exactly 32 bytes. Unset means TOTP secrets are stored in PLAINTEXT
# with only a log warning, so the placeholder here is deliberately invalid.
#   generate: openssl rand -base64 32
MFA_KEY_KEK=<generate: openssl rand -base64 32>

# Hex, not base64: this is substituted into a postgres:// DSN where base64's
# + and / would need percent-encoding. The overlay references it as
# `${POSTGRES_PASSWORD:?...}`, so omitting or blanking the key fails the render
# rather than falling back to the base file's dev default — which is why it
# ships EMPTY, like JWT_SECRET/REDIS_PASSWORD. On a host with an EXISTING
# database volume, set the database's CURRENT password: the value only
# initializes a fresh volume (see deploy/README.md).
#   generate: openssl rand -hex 32
POSTGRES_USER=vidra
POSTGRES_PASSWORD=
POSTGRES_DB=vidra

# docker-compose.prod.yml starts redis with --requirepass ${REDIS_PASSWORD} and
# derives both clients' DSNs from it (api on /0, search on /1), so this one value
# is all that is needed — do not hand-write REDIS_URL as well.
#   generate: openssl rand -hex 32
# Left EMPTY like JWT_SECRET above: the overlay references it as
# `${REDIS_PASSWORD:?...}`, which fails the render on an empty value as well as an
# unset one — so an unedited copy is caught by `make prod-config` rather than
# starting Redis with a literal placeholder as its password.
REDIS_PASSWORD=

# Managed-database overrides. Leave commented to use the bundled Postgres, which
# is the right choice for staging (a throwaway database you can drop and re-seed).
# If production uses a managed database, staging should too — that is the point.
# One DSN covers the api, the search service and both migration one-shots (the
# search migrator compiles its vidra_search_migrations ledger name in, so it no
# longer needs a DSN of its own).
# DATABASE_URL=postgresql://doadmin:PASSWORD@stg-db.example.ondigitalocean.com:25060/defaultdb?sslmode=require

# ------------------------------------------------------------------------------
# Instance identity
# ------------------------------------------------------------------------------
# Name it visibly as staging: it is served publicly at GET /api/v1/instance and in
# NodeInfo, and it is the default TOTP issuer label — so a tester who enrols MFA
# sees which instance the code belongs to.
INSTANCE_NAME=Example Video (staging)
INSTANCE_DESCRIPTION=Throwaway staging instance. Data here is deleted without notice.
INSTANCE_TERMS_URL=
INSTANCE_PRIVACY_URL=
INSTANCE_CONTACT_EMAIL=

# ------------------------------------------------------------------------------
# Registration
# ------------------------------------------------------------------------------
# Same first-boot hazard as production: the FIRST account on an empty users table
# is granted admin. Claim the owner account before anything else can reach the
# host, then decide whether to open signups for testers.
REGISTRATION_ENABLED=false
REGISTRATION_REQUIRE_APPROVAL=false

# ------------------------------------------------------------------------------
# Rate limits, timeouts and upload sizing — keep IDENTICAL to production
# ------------------------------------------------------------------------------
# These are the values most likely to be wrong in production, and the only place
# they can be caught is a staging run with real client link speeds. Do not relax
# them here: a staging instance with the limiter off proves nothing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
MEDIA_RATE_LIMIT_REQUESTS=3000
HTTP_REQUEST_TIMEOUT=30s
HTTP_STREAM_REQUEST_TIMEOUT=1h
UPLOAD_MAX_SIZE=2G
# 5 GiB, matching production. Quota sums video_files only (the HLS ladder in
# video_renditions is uncounted), so real consumption exceeds this.
INSTANCE_DEFAULT_QUOTA_BYTES=5368709120

# ------------------------------------------------------------------------------
# Media storage — a SEPARATE Space from production
# ------------------------------------------------------------------------------
# Never point staging at the production bucket: staging exercises delete paths,
# re-transcodes and the garbage collector.
STORAGE_BACKEND=s3
# HOST ONLY — no scheme; a value containing "://" is rejected outright.
STORAGE_S3_ENDPOINT=nyc3.digitaloceanspaces.com
STORAGE_S3_REGION=nyc3
STORAGE_S3_BUCKET=example-video-media-staging
STORAGE_S3_ACCESS_KEY=<your staging Spaces access key>
STORAGE_S3_SECRET_KEY=<your staging Spaces secret key>
STORAGE_S3_USE_SSL=true
STORAGE_S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Transcoding
# ------------------------------------------------------------------------------
TRANSCODING_ENABLED=true
TRANSCODING_VP9_ENABLED=false

# ------------------------------------------------------------------------------
# Malware scanning (ClamAV)
# ------------------------------------------------------------------------------
# Off by default here too — clamd holds ~1.5-2 GiB resident and lives in a compose
# profile that is not started by default, so enabling the flag alone is a boot
# failure. If production will run it, turn it on in staging FIRST and verify with
# an EICAR upload; that is the only way to prove the fail-closed path works.
#   MALWARE_SCAN_ENABLED=true
#   CLAMAV_ADDR=clamav:3310      # `clamav` is the compose SERVICE NAME
#   ... and add --profile scan to every compose command.
MALWARE_SCAN_ENABLED=false

# ------------------------------------------------------------------------------
# Feature flags (boot-time seeds; admins change them live in the admin UI)
# ------------------------------------------------------------------------------
# Off unless an RTMP ingest is actually provisioned: with LIVE_RTMP_URL empty the
# UI hides the server-URL row, so creators get a stream key pointing nowhere.
FEATURE_LIVE_ENABLED=false
FEATURE_UPLOADS_ENABLED=true
FEATURE_IMPORTS_ENABLED=true
FEATURE_COMMENTS_ENABLED=true
QUARANTINE_NEW_UPLOADS=false

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
# /metrics is root-mounted with NO authentication; it is safe only because the api
# port is loopback-published and the reverse proxy does not route that path to the
# api. Verify before enabling.
METRICS_ENABLED=true
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=vidra-core
# FRONTEND_OTEL_SERVICE_NAME=vidra-user

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
# Use a real relay with a SEPARATE from-address (e.g. staging@) so staging mail is
# distinguishable and a staging bug cannot damage the production domain's sending
# reputation. SMTP_HOST and SMTP_FROM are REQUIRED when MAIL_ENABLED=true.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SECRET — never commit a real value.
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------------------
# Dev/test seams — MUST stay false, even on staging
# ------------------------------------------------------------------------------
# It is tempting to enable DEV_MAIL_CAPTURE_ENABLED on staging to skip real mail.
# Don't: GET /api/v1/dev/email-token has NO auth and returns a live password-reset
# token for any address, and staging is internet-facing. Test the mail path for
# real — that is what staging is for.
DEV_MAIL_CAPTURE_ENABLED=false
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false

# ------------------------------------------------------------------------------
# vidra-search (internal service — never browser-facing)
# ------------------------------------------------------------------------------
# SEARCH_HTTP_PORT is deliberately absent: setting it publishes the internal search
# service on a host port. docker-compose.prod.yml removes the publish with
# `ports: !reset []` there — a plain `ports: []` would merge with the base file's
# mapping rather than replace it, so the port would stay open. Needs Compose >= 2.24.
#
# SEARCH_SERVICE_URL must be set explicitly — the production `-f` compose chain
# disables auto-loading of docker-compose.override.yml, which is where local
# development gets this value. Unset, search degrades silently to local SQL, and
# a staging run would "pass" without ever exercising the search service.
SEARCH_SERVICE_URL=http://search:8080
# Shared HMAC secret; must equal the search service's INTERNAL_SECRET (one
# substitution feeds both). Required at >=32 characters whenever the URL is set in
# production mode. Different from production's.
#   generate: openssl rand -hex 32
SEARCH_INTERNAL_SECRET=<generate: openssl rand -hex 32>

# ------------------------------------------------------------------------------
# ActivityPub federation (off)
# ------------------------------------------------------------------------------
# Keep this OFF on staging unless you are deliberately testing federation: a
# staging instance that federates emits real activities to real remote servers
# with actor ids under the staging domain, and remote caches do not forget.
# When on, FEDERATION_KEY_KEK (base64 of exactly 32 bytes) becomes required.
#   generate: openssl rand -base64 32
FEDERATION_ENABLED=false
# FEDERATION_KEY_KEK=
