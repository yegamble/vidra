# Testing/QA (remote) — the environment the backed e2e suite models.
# These flags MUST stay in lock-step with vidra-user/.github/workflows/frontend-e2e-backed.yml
# (that workflow IS the QA contract). Canonical matrix: .ralph/specs/environments.md
#
# ##############################################################################
# # DANGER — THIS TEMPLATE IS NOT SAFE ON AN INTERNET-REACHABLE HOST.          #
# ##############################################################################
#
# It sets DEV_MAIL_CAPTURE_ENABLED=true and HTTP_IMPORT_ALLOW_PRIVATE_URLS=true
# (below). Each one is a complete compromise on its own:
#
#   DEV_MAIL_CAPTURE_ENABLED       -> registers GET /api/v1/dev/email-token with
#                                     NO auth middleware. Anyone who can reach
#                                     the host asks it for a live password-reset
#                                     token for any address, including the owner
#                                     admin account. That is instant takeover.
#   HTTP_IMPORT_ALLOW_PRIVATE_URLS -> disables the dial-time SSRF guard, so the
#                                     URL importer will fetch RFC1918, loopback
#                                     and link-local addresses — including the
#                                     cloud metadata service at 169.254.169.254,
#                                     i.e. the droplet's own credentials.
#
# NOTHING IN THE APPLICATION STOPS THIS. vidra-core's fail-secure refusals for
# both flags live inside `if c.Environment == "production"`, and this file sets
# VIDRA_ENV=test — so the api boots happily with both switches on. The only
# controls are (a) never running this template anywhere the internet can reach
# and (b) never copy-pasting these two lines into another env file.
#
# QA belongs behind a VPN, an allow-listed IP, or on a host with no public
# ingress at all. If a QA box must be publicly addressable, set both to false and
# accept that the backed e2e suite's mail and private-URL specs will fail.
VIDRA_ENV=test
HTTP_PORT=8080
FRONTEND_PORT=3000
PUBLIC_BASE_URL=https://qa-api.example.com
NEXT_PUBLIC_API_BASE_URL=https://qa-api.example.com
CORS_ALLOWED_ORIGINS=https://qa.example.com
RATE_LIMIT_ENABLED=false
# vvv THE TWO DANGEROUS LINES — see the DANGER block at the top of this file. vvv
# Account takeover (unauthenticated password-reset token endpoint) and SSRF
# (importer may fetch 169.254.169.254 and RFC1918). Only safe on a host the
# internet cannot reach. Never copy these into staging or production.
DEV_MAIL_CAPTURE_ENABLED=true
HTTP_IMPORT_ALLOW_PRIVATE_URLS=true
# ^^^ THE TWO DANGEROUS LINES ^^^
MAIL_ENABLED=false
TRANSCODING_ENABLED=true
MALWARE_SCAN_ENABLED=false
STORAGE_BACKEND=local
FEDERATION_ENABLED=true
# FEDERATION_KEY_KEK=<base64 32 bytes — required when federation is on outside dev>
#   generate: openssl rand -hex 24
LIVE_INGEST_SECRET=<generate: openssl rand -hex 24>
REGISTRATION_REQUIRE_APPROVAL=false
# vidra-search (internal autosuggest/search/recommendations service; core-only).
# NOT part of the frontend-e2e-backed.yml contract — that suite exercises the
# frontend against vidra-core only, so these meta-stack additions don't affect the
# lock-step note above.
#   generate: openssl rand -hex 32
SEARCH_HTTP_PORT=8081
SEARCH_INTERNAL_SECRET=<generate: openssl rand -hex 32>
