# Shared dev sandbox (remote). Canonical matrix: .ralph/specs/environments.md
VIDRA_ENV=development
HTTP_PORT=8080
FRONTEND_PORT=3000
PUBLIC_BASE_URL=https://dev-api.example.com
NEXT_PUBLIC_API_BASE_URL=https://dev-api.example.com
CORS_ALLOWED_ORIGINS=https://dev.example.com
RATE_LIMIT_ENABLED=true
# Both MUST stay false: this sandbox is internet-reachable and VIDRA_ENV is
# development, so vidra-core's fail-secure refusals (which only fire when the
# environment is production) will NOT save you. DEV_MAIL_CAPTURE_ENABLED exposes
# an unauthenticated endpoint returning a live password-reset token for any
# address; HTTP_IMPORT_ALLOW_PRIVATE_URLS lets the importer fetch RFC1918,
# loopback and the 169.254.169.254 metadata service. Do not copy them from
# env/qa.env.example.
DEV_MAIL_CAPTURE_ENABLED=false
HTTP_IMPORT_ALLOW_PRIVATE_URLS=false
MAIL_ENABLED=false
TRANSCODING_ENABLED=true
# Malware scanning is derived from CLAMAV_ADDR, and an instance with neither a
# scanner nor an explicit opt-out refuses every upload with 503
# scanner_not_configured.
#
# THIS IS A DEV TEMPLATE AND IT TAKES THE OPT-OUT ON PURPOSE. The production and
# staging templates ship scanning ON; this one cannot, because the Makefile's dev
# targets hardcode `--profile core --profile frontend` and never start the
# bundled clamd. Pointing CLAMAV_ADDR at a container that no dev target runs
# would make fail-closed refuse every upload on `make dev` — the opt-out is
# exactly the mechanism for "this instance ingests unscanned, and says so".
#
# It costs a boot WARN and one system.malware_scan.disabled audit row per boot,
# which is the point: even here, the absence of scanning is on the record.
#
# To develop AGAINST a real scanner, add `--profile scan` to your compose
# command, set CLAMAV_ADDR=clamav:3310, and delete this line (a configured
# scanner alongside `disabled` is refused at boot).
MALWARE_SCAN_MODE=disabled
STORAGE_BACKEND=local
FEDERATION_ENABLED=false
REGISTRATION_REQUIRE_APPROVAL=false
# vidra-search (internal autosuggest/search/recommendations service; core-only).
# SEARCH_INTERNAL_SECRET is the shared core↔search HMAC secret (flows to both the
# api and the search service). A shared remote sandbox sets a real value from the
# host env/secret store — never commit one.
SEARCH_HTTP_PORT=8081
# SEARCH_INTERNAL_SECRET=<strong >=32-byte secret — set from the host secret store>
